{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "底栏写作",
  "version": "0.1.0",
  "identifier": "com.example.bottomeditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "底栏写作",
        "width": 1000,
        "height": 720,
        "minWidth": 460,
        "minHeight": 300,
        "fullscreen": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
